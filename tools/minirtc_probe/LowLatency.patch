+MiniRtcVideoSendQueueStats IceTransportController::TakeVideoSendQueueStats() {
+  std::lock_guard<std::mutex> lock(video_send_queue_mutex_);
+  auto stats = video_send_queue_stats_;
+  if (!stats.packets) return stats;
+  const auto target = stats.packets - stats.packets / 20;
+  uint64_t count = 0;
+  for (size_t bucket = 0; bucket < video_send_queue_buckets_.size(); ++bucket) {
+    count += video_send_queue_buckets_[bucket];
+    if (count >= target) {
+      stats.p95_bucket_ms = static_cast<uint32_t>(bucket);
+      break;
+    }
+  }
+  video_send_queue_stats_ = {};
+  video_send_queue_buckets_.fill(0);
+  return stats;
+}
