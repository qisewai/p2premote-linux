{
  "version": 3,
  "configurePresets": [
    {
      "name": "linux-x64-viewer",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/linux-x64-viewer",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "windows-x64",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/out/build/windows-x64"
    },
    {
      "name": "windows-x64-webrtc",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/windows-x64-webrtc",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded",
        "CMAKE_TRY_COMPILE_CONFIGURATION": "Release"
      }
    },
    {
      "name": "windows-x64-qt",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/windows-x64-qt",
      "installDir": "${sourceDir}/dist/app",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "P2PREMOTE_BUILD_QT": "ON",
        "VCPKG_TARGET_TRIPLET": "x64-windows-release",
        "VCPKG_HOST_TRIPLET": "x64-windows-release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "linux-x64-viewer",
      "configurePreset": "linux-x64-viewer"
    },
    {
      "name": "windows-x64-release",
      "configurePreset": "windows-x64",
      "configuration": "Release"
    },
    {
      "name": "windows-x64-webrtc-release",
      "configurePreset": "windows-x64-webrtc",
      "configuration": "Release"
    },
    {
      "name": "windows-x64-qt-release",
      "configurePreset": "windows-x64-qt",
      "targets": ["install"],
      "configuration": "Release"
    }
  ],
  "testPresets": [
    {
      "name": "linux-x64-viewer",
      "configurePreset": "linux-x64-viewer",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "windows-x64-webrtc-release",
      "configurePreset": "windows-x64-webrtc",
      "configuration": "Release",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "windows-x64-qt-release",
      "configurePreset": "windows-x64-qt",
      "configuration": "Release",
      "output": { "outputOnFailure": true }
    }
  ]
}
