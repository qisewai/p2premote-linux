+bool ShouldApplyVideoBitrate(int target, std::optional<int> applied) {
+  // Admission handles a zero budget without reconfiguring the codec.
+  if (target <= 0) return false;
+  if (!applied) return true;
+
+  // Keep small estimator fluctuations off the encode queue.
+  const auto delta = std::abs(static_cast<int64_t>(target) - *applied);
+  return delta >= 100'000 || delta * 25 >= *applied;
 }
 
