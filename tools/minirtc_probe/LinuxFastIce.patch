   return mode == TurnMode::TurnForceUdp || mode == TurnMode::TurnForceTcp;
 }
 
+#if defined(__linux__) && !defined(__ANDROID__)
+bool IsVirtualLinuxInterface(const char* name) {
+  if (!name || !*name) return true;
+  static constexpr const char* kPrefixes[] = {
+      "docker", "br-", "veth", "vmnet", "virbr", "vboxnet",
+      "cni", "flannel", "kube", "podman", "lxc", "lxd", "incus"};
+  for (const char* prefix : kPrefixes) {
+    if (std::strncmp(name, prefix, std::strlen(prefix)) == 0) return true;
+  }
+  return false;
+}
+
+void RegisterFilteredLinuxLocalAddresses(NiceAgent* agent) {
+  ifaddrs* ifas = nullptr;
+  if (getifaddrs(&ifas) != 0 || !ifas) return;
+
+  std::vector<NiceAddress> addresses;
+  std::set<std::string> seen;
+  for (ifaddrs* ifa = ifas; ifa != nullptr; ifa = ifa->ifa_next) {
+    if (!ifa->ifa_addr) continue;
+    if ((ifa->ifa_flags & IFF_UP) == 0 || (ifa->ifa_flags & IFF_LOOPBACK) != 0) {
+      continue;
+    }
+    if (IsVirtualLinuxInterface(ifa->ifa_name)) continue;
+
+    const int family = ifa->ifa_addr->sa_family;
+    char text[INET6_ADDRSTRLEN] = {};
+    if (family == AF_INET) {
+      const auto* sin = reinterpret_cast<const sockaddr_in*>(ifa->ifa_addr);
+      const uint32_t ip = ntohl(sin->sin_addr.s_addr);
+      if ((ip & 0xff000000u) == 0x7f000000u) continue;
+      if ((ip & 0xffff0000u) == 0xa9fe0000u) continue;
+      if ((ip & 0xfffe0000u) == 0xc6120000u) continue;
+      if (!inet_ntop(AF_INET, &sin->sin_addr, text, sizeof(text))) continue;
+    } else if (family == AF_INET6) {
+      const auto* sin6 = reinterpret_cast<const sockaddr_in6*>(ifa->ifa_addr);
+      if (IN6_IS_ADDR_LOOPBACK(&sin6->sin6_addr) ||
+          IN6_IS_ADDR_LINKLOCAL(&sin6->sin6_addr) ||
+          IN6_IS_ADDR_MULTICAST(&sin6->sin6_addr) ||
+          IN6_IS_ADDR_UNSPECIFIED(&sin6->sin6_addr)) {
+        continue;
+      }
+      if (!inet_ntop(AF_INET6, &sin6->sin6_addr, text, sizeof(text))) continue;
+    } else {
+      continue;
+    }
+
+    if (!seen.insert(text).second) continue;
+    NiceAddress nice_addr;
+    nice_address_init(&nice_addr);
+    nice_address_set_from_sockaddr(&nice_addr, ifa->ifa_addr);
+    nice_address_set_port(&nice_addr, 0);
+    addresses.push_back(nice_addr);
+  }
+  freeifaddrs(ifas);
+
+  if (addresses.empty()) return;
+  size_t added = 0;
+  for (auto& addr : addresses) {
+    if (nice_agent_add_local_address(agent, &addr)) ++added;
+  }
+  LOG_INFO("ICE filtered local Linux addresses [{}]", added);
+}
+#endif
+
 }  // namespace
 
